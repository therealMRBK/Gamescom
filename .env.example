DATABASE_URL="postgresql://gamescom:gamescom@localhost:5432/gamescom?schema=public"
AUTH_SECRET="change-me-to-a-random-32-byte-string"
NEXTAUTH_URL="http://localhost:3000"

# Seed script: initial admin login
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-me"
ADMIN_NAME="Admin"

# KI-Funktionen (Content-Entwürfe, Outreach-E-Mails, Tages-Briefing, Prioritäts-Vorschlag)
# Ohne gesetzten Key funktioniert die App normal, die KI-Buttons zeigen dann einen Fehlerhinweis.
ANTHROPIC_API_KEY=""

# Schlüssel zur Verschlüsselung gespeicherter IMAP-Passwörter (Einstellungen -> Postfach).
# 32 zufällige Byte, base64-kodiert. Erzeugen mit: openssl rand -base64 32
# Ohne gesetzten Schlüssel funktioniert die App normal, das Verbinden eines Postfachs schlägt dann fehl.
IMAP_ENCRYPTION_KEY=""
